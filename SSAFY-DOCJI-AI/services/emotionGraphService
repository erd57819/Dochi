def update_emotion_graph(data, redis_client):
    room_id = data["roomId"]
    speaker = data["speaker"]
    emotion_scores = data.get("emotion", {})  # e.g. {"angry": 30, "sad": 20}

    key = f"stt:graph:{room_id}"
    entry = {
        "timestamp": data.get("timestamp"),
        "speaker": speaker,
        **emotion_scores
    }

    redis_client.rpush(key, json.dumps(entry))
    print(f"[감정 그래프] {key} ← {entry}")
