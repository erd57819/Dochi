pipeline {
    agent any

    environment {
        // Git 설정
        GIT_REPO = 'https://github.com/your-username/SSAFY-DOCHI.git'
        GIT_BRANCH = 'main'

        // Docker 설정
        DOCKER_REGISTRY = 'your-dockerhub-username'
        FRONTEND_IMAGE = "${DOCKER_REGISTRY}/dochi-frontend"
        BACKEND_IMAGE = "${DOCKER_REGISTRY}/dochi-backend"

        // 환경 변수
        DB_PASSWORD = credentials('db-password')
        JWT_SECRET = credentials('jwt-secret')
        MYSQL_ROOT_PASSWORD = credentials('mysql-root-password')

        // 배포 설정
        DEPLOY_ENV = 'production'
        HEALTH_CHECK_URL = 'http://localhost:8080/actuator/health'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        skipStagesAfterUnstable()
    }

    stages {
        stage('Preparation') {
            steps {
                script {
                    env.BUILD_VERSION = "${env.BUILD_NUMBER}-${env.GIT_COMMIT[0..7]}"
                    echo "빌드 버전: ${env.BUILD_VERSION}"
                }

                // 작업 공간 정리
                cleanWs()

                // Git 코드 체크아웃
                checkout scm

                // 환경 파일 생성
                sh '''
                    echo "DB_PASSWORD=${DB_PASSWORD}" > .env
                    echo "JWT_SECRET=${JWT_SECRET}" >> .env
                    echo "MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}" >> .env
                '''
            }
        }

        stage('Code Quality Check') {
            parallel {
                stage('Frontend Lint') {
                    steps {
                        dir('SSAFY-DOCHI-FE') {
                            sh '''
                                npm ci
                                npm run lint
                            '''
                        }
                    }
                }

                stage('Backend Test') {
                    steps {
                        dir('SSAFY-DOCHI-BE') {
                            sh '''
                                ./mvnw clean test
                                ./mvnw checkstyle:check
                            '''
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'SSAFY-DOCHI-BE/target/surefire-reports/*.xml'
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'SSAFY-DOCHI-BE/target/site/checkstyle',
                                reportFiles: 'checkstyle.html',
                                reportName: 'Checkstyle Report'
                            ])
                        }
                    }
                }
            }
        }

        stage('Build & Push Docker Images') {
            parallel {
                stage('Frontend Image') {
                    steps {
                        dir('SSAFY-DOCHI-FE') {
                            script {
                                def frontendImage = docker.build("${FRONTEND_IMAGE}:${env.BUILD_VERSION}")
                                docker.withRegistry('https://registry-1.docker.io/v2/', 'dockerhub-credentials') {
                                    frontendImage.push()
                                    frontendImage.push('latest')
                                }
                            }
                        }
                    }
                }

                stage('Backend Image') {
                    steps {
                        dir('SSAFY-DOCHI-BE') {
                            script {
                                def backendImage = docker.build("${BACKEND_IMAGE}:${env.BUILD_VERSION}")
                                docker.withRegistry('https://registry-1.docker.io/v2/', 'dockerhub-credentials') {
                                    backendImage.push()
                                    backendImage.push('latest')
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                branch 'main'
            }
            steps {
                script {
                    // 기존 컨테이너 중지 및 제거
                    sh '''
                        docker-compose down || true
                        docker system prune -f
                    '''

                    // 새 버전으로 배포
                    sh '''
                        export FRONTEND_IMAGE_TAG=${BUILD_VERSION}
                        export BACKEND_IMAGE_TAG=${BUILD_VERSION}
                        docker-compose up -d --force-recreate
                    '''

                    // 배포 대기
                    sleep(time: 30, unit: 'SECONDS')
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    def maxAttempts = 10
                    def attempt = 0
                    def healthCheckPassed = false

                    while (attempt < maxAttempts && !healthCheckPassed) {
                        try {
                            sh "curl -f ${HEALTH_CHECK_URL}"
                            healthCheckPassed = true
                            echo "헬스 체크 성공!"
                        } catch (Exception e) {
                            attempt++
                            echo "헬스 체크 실패 (${attempt}/${maxAttempts}). 30초 후 재시도..."
                            sleep(time: 30, unit: 'SECONDS')
                        }
                    }

                    if (!healthCheckPassed) {
                        error("헬스 체크 실패: 애플리케이션이 정상적으로 시작되지 않았습니다.")
                    }
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    // 기본 API 엔드포인트 테스트
                    sh '''
                        curl -f http://localhost/api/notice || exit 1
                        echo "스모크 테스트 통과!"
                    '''
                }
            }
        }
    }

    post {
        always {
            // 환경 파일 정리
            sh 'rm -f .env'

            // Docker 이미지 정리
            sh '''
                docker image prune -f
                docker volume prune -f
            '''
        }

        success {
            echo "🎉 배포 성공! 버전: ${env.BUILD_VERSION}"

            // Slack 알림 (선택사항)
            // slackSend(
            //     channel: '#deployment',
            //     color: 'good',
            //     message: "✅ DOCHI 배포 성공\n버전: ${env.BUILD_VERSION}\n브랜치: ${env.GIT_BRANCH}"
            // )
        }

        failure {
            echo "❌ 배포 실패!"

            // 실패 시 롤백
            sh '''
                docker-compose down || true
                docker-compose up -d || true
            '''

            // Slack 알림 (선택사항)
            // slackSend(
            //     channel: '#deployment',
            //     color: 'danger',
            //     message: "❌ DOCHI 배포 실패\n버전: ${env.BUILD_VERSION}\n브랜치: ${env.GIT_BRANCH}\n로그를 확인해주세요."
            // )
        }

        unstable {
            echo "⚠️ 빌드가 불안정합니다."
        }
    }
}