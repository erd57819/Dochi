<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.dochi.user.dao.UserDao">

    <resultMap id="UserResultMap" type="com.ssafy.dochi.user.domain.User">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="name" column="name"/>
        <result property="nickname" column="nickname"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="address" column="address"/>
        <result property="age" column="age"/>
        <result property="gender" column="gender"/>
        <result property="role" column="role"/>
        <result property="isSocial" column="is_social"/>
        <result property="kakaoId" column="kakao_id"/>
        <result property="googleId" column="google_id"/>
        <result property="emailVerified" column="email_verified"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="refreshToken" column="refresh_token"/>
        <result property="profileImage" column="profile_image"/>
    </resultMap>

    <insert id="save" parameterType="com.ssafy.dochi.user.domain.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO users (
            user_id, name, nickname, email, password, address, age, gender,
            role, is_social, kakao_id, google_id, email_verified,
            refresh_token, profile_image
        )
        VALUES (
                   #{userId}, #{name}, #{nickname}, #{email}, #{password}, #{address}, #{age}, #{gender},
                   #{role}, #{isSocial}, #{kakaoId}, #{googleId}, #{emailVerified},
                   #{refreshToken}, #{profileImage}
               )
    </insert>

    <select id="findById" resultMap="UserResultMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="findByUserId" resultMap="UserResultMap">
        SELECT * FROM users WHERE user_id = #{userId}

    </select>

    <select id="findByEmail" resultType="com.ssafy.dochi.user.domain.User">
        SELECT * FROM users
        WHERE email = #{email}

    </select>


    <select id="findByNickname" resultMap="UserResultMap">
        SELECT * FROM users WHERE nickname = #{nickname}
    </select>

    <update id="update">
        UPDATE users
        SET name = #{name},
            nickname = #{nickname},
            address = #{address},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE users
        SET password = #{password},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updateProfileImage">
        UPDATE users
        SET profile_image = #{profileImage},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="updateRefreshToken">
        UPDATE users
        SET refresh_token = #{refreshToken},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <update id="deleteById">
        DELETE from users
        WHERE id = #{id}
    </update>

    <update id="deleteByKakaoId">
        UPDATE users
        WHERE kakao_id = #{kakaoId}
    </update>

    <update id="deleteByGoogleId">
        UPDATE users
        WHERE google_id = #{googleId}
    </update>
    <select id="userInfo" resultType="com.ssafy.dochi.user.dto.response.UserInfoResDto">
        SELECT
            user_id AS userId,
            name,
            nickname,
            email,
            address,
            age,
            gender,
            profile_image AS profileImage,
            created_at AS createdAt
        FROM users
        WHERE id = #{id}
    </select>


</mapper>
