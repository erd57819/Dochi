<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.project.chat.repository.ChatDao">

    <insert id="saveChatRoom" parameterType="com.ssafy.project.chat.domain.ChatRoom" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chatroom (user_id)
        VALUES (#{userId})
    </insert>

    <insert id="saveChat" useGeneratedKeys="true" keyProperty="id" parameterType="com.ssafy.project.chat.domain.Chat">
        INSERT INTO chat (chatroom_id, sender_type, message, timestamp)
        VALUES (#{chatRoomId}, #{senderType}, #{message}, #{timestamp})
    </insert>

    <select id="findChatRoomIdByUserId" parameterType="long" resultType="long">
        SELECT id FROM chatroom WHERE user_id = #{userId}
    </select>

    <select id="findAllByChatRoomId" resultType="com.ssafy.project.chat.domain.Chat">
        SELECT id, sender_type, message, timestamp, chatroom_id
        FROM chat
        WHERE chatroom_id = #{chatRoomId}
        ORDER BY timestamp ASC
    </select>

</mapper>